<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <RootNamespace>EmbyBackup</RootNamespace>
    <AssemblyName>EmbyBackup</AssemblyName>
    <Version>1.1.1</Version>
    <AssemblyVersion>1.1.1.0</AssemblyVersion>
    <FileVersion>1.1.1.0</FileVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Nullable>disable</Nullable>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <!-- Emby provides these at runtime. Only EmbyBackup.dll goes into plugins/. -->
    <PackageReference Include="MediaBrowser.Server.Core" Version="4.9.1.90" PrivateAssets="all" ExcludeAssets="runtime" />
    <!-- ILogger's obsolete ReadOnlyMemory<char> overloads need this reference at compile time; Emby provides it at runtime. -->
    <PackageReference Include="System.Memory" Version="4.6.0" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web/configPage.html" />
    <EmbeddedResource Include="Web/configPage.js" />
    <EmbeddedResource Include="Images/thumb.png" />
  </ItemGroup>

</Project>
